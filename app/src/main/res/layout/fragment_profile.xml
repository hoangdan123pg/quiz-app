<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#0D0D2D"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

<LinearLayout
android:orientation="vertical"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:gravity="center_horizontal">

<!-- Avatar (same as before) -->
<ImageView
    android:id="@+id/iv_avatar"
    android:layout_width="120dp"
    android:layout_height="120dp"
    android:scaleType="centerCrop"
    android:background="@drawable/bg_cricle"
    android:clipToOutline="true"
    android:outlineProvider="background"
    android:padding="4dp"/>

<TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Tap to change"
    android:textSize="12sp"
    android:textColor="#CCC"
android:layout_marginTop="4dp"/>

<!-- Email -->
<TextView
    android:id="@+id/tv_email"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="24dp"
    android:textColor="#FFF"
android:gravity="center"
android:textSize="14sp"/>

<!-- Username -->
<EditText
    android:id="@+id/et_username"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:textColor="#FFF"
    android:textColorHint="#BBB"
    android:gravity="center"
    android:textSize="16sp"
    android:background="@null"/>

<!-- Streak Card (no changes) -->
<androidx.cardview.widget.CardView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="32dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#1A1A3A">

    <LinearLayout
        android:orientation="vertical"
        android:gravity="center"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        app:tint="#f97316"
        android:src="@drawable/fire"/>

    <TextView
        android:id="@+id/tvCurrentStreak"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Current Streak: 3 days"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFF"
        android:textAlignment="center"
    android:gravity="center" />

    <TextView
        android:id="@+id/tvBestStreak"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Best Streak: 5 days"
        android:textSize="14sp"
        android:textColor="#FFF"
        android:textAlignment="center"
    android:gravity="center" />
</LinearLayout>

</androidx.cardview.widget.CardView>

<!-- Save -->
<Button
    android:id="@+id/btn_save"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="32dp"
    android:textColor="#0D0D2D"
    android:backgroundTint="#FFF"
    android:text="Save"/>
</LinearLayout>
    </ScrollView>
