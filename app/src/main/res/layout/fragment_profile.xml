<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal">

        <!-- 1) Avatar -->
        <ImageView
            android:id="@+id/iv_avatar"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/avt"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_cricle"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Avatar"
            android:clipToOutline="true"
            android:outlineProvider="background"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to change"
            android:textSize="12sp"
            android:textColor="#888"
            android:layout_marginTop="4dp"/>

        <!-- 2) Email (read‑only) -->
        <TextView
            android:id="@+id/tv_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="you@example.com"
            android:gravity="center"
            android:textSize="14sp"
            android:textColor="#444"/>

        <!-- 3) Username (inline editable) -->
        <EditText
            android:id="@+id/et_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Your display name"
            android:gravity="center"
            android:textSize="16sp"
            android:background="@null"
            android:inputType="textPersonName"/>

        <!-- 4) Streak Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/fire"
                    app:tint="#f97316"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/tvCurrentStreak"
                    android:layout_marginTop="12dp"
                    android:text="Current Streak: 3 days"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/tvBestStreak"
                    android:layout_marginTop="4dp"
                    android:text="Best Streak: 5 days"
                    android:textSize="14sp"
                    android:textColor="#555"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 5) Save button -->
        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save"
            android:layout_marginTop="32dp"/>
    </LinearLayout>
</ScrollView>
